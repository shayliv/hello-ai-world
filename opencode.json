{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "read": {
      "*": "allow",
      ".git/**": "deny",
      ".env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      ".opencode/**": "deny",
      "AGENTS.md": "deny",
      "CONTRIBUTING.md": "deny",
      "OPERATIONS.md": "deny",
      "README.md": "deny",
      "HISTORY.md": "deny",
      "Dockerfile": "deny",
      ".dockerignore": "deny",
      ".gitmodules": "deny",
      "scripts/validate-evolution.mjs": "deny",
      "scripts/check-classifier.mjs": "deny",
      "scripts/classify-candidate.mjs": "deny",
      "scripts/product-hash.mjs": "deny",
      "scripts/render-ledger.mjs": "deny",
      "scripts/verify-release.mjs": "deny",
      "state/**": "deny",
      "cycles/**": "deny",
      "releases/**": "deny",
      "docs/previews/**": "deny",
      "proposals/**": "deny"
    },
    "bash": {
      "*": "deny",
      "pwd": "allow",
      "ls*": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed -n *": "allow",
      "wc *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "npm ci --ignore-scripts*": "allow",
      "npm install --ignore-scripts*": "allow",
      "pnpm test*": "allow",
      "pnpm run *": "allow",
      "go test*": "allow",
      "gofmt *": "allow",
      "cargo test*": "allow",
      "cargo fmt*": "allow"
    }
  }
}
